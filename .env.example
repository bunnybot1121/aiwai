# RocketRide Engine Connection Credentials
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=local_key_buildathon

# Database Configuration (SQLite default, PostgreSQL optional)
DATABASE_URL=sqlite+aiosqlite:///./saveflow.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/saveflow

# System Workspace Settings
COMPANY_ID=NOVACLOUD
COMPANY_NAME=NovaCloud Inc
PORT=8000

# Groq LLM Configuration (Server-Side Only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

