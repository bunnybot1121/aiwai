{
  "pipeline": {
    "name": "SaveFlow Human Approval & Policy Validator",
    "source": "validator_input",
    "version": "1.0.0",
    "description": "Evaluates confidence score, financial impact, and policy thresholds to determine if an action can run automatically or requires human review.",
    "components": [
      {
        "id": "validator_input",
        "provider": "webhook",
        "config": {
          "mode": "Source"
        }
      },
      {
        "id": "validator_agent",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    score = data.get('risk_score', 0)\n    human_req = score >= 85\n    return {'human_approval_required': human_req, 'execution_path': 'HUMAN_APPROVAL_GATE' if human_req else 'SAFE_AUTO_ACTION'}"
        },
        "input": [
          {
            "lane": "text",
            "from": "validator_input"
          }
        ]
      },
      {
        "id": "validator_output",
        "provider": "response_text",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "validator_agent"
          }
        ]
      }
    ],
    "project_id": "465e7a8c-f9eb-4cf9-ad23-93c4b8838037"
  }
}