{
  "name": "SaveFlow Master Churn Scoring Agent",
  "version": "1.0.0",
  "description": "Combines outputs from specialist agents (usage, billing, support, contact) into a unified churn risk score, confidence level, and structured evidence reasons.",
  "components": [
    {
      "id": "churn_input",
      "provider": "webhook",
      "config": {
        "schema": {
          "type": "object",
          "properties": {
            "usage_analysis": { "type": "object" },
            "billing_analysis": { "type": "object" },
            "support_analysis": { "type": "object" },
            "contact_analysis": { "type": "object" }
          }
        }
      }
    },
    {
      "id": "churn_agent",
      "provider": "agent_llm",
      "config": {
        "system_prompt": "You are the Master Churn Risk Agent for NovaCloud SaaS. Combine usage, billing, support, and contact health signals into an overall risk_score (0-100), risk_level (low: 0-39, medium: 40-69, high: 70-84, critical: 85-100), confidence (0.0-1.0), and reasons array. Lower confidence when data is missing.",
        "temperature": 0.2
      },
      "input": [
        { "lane": "data", "from": "churn_input" }
      ]
    },
    {
      "id": "churn_output",
      "provider": "response",
      "config": {
        "laneName": "churn_risk"
      },
      "input": [
        { "lane": "text", "from": "churn_agent" }
      ]
    }
  ]
}
