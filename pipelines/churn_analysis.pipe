{
  "pipeline": {
    "name": "SaveFlow Master Churn Scoring Agent",
    "source": "churn_input",
    "version": "1.0.0",
    "description": "Combines outputs from specialist agents (usage, billing, support, contact) into a unified churn risk score, confidence level, and structured evidence reasons.",
    "components": [
      {
        "id": "churn_input",
        "provider": "webhook",
        "config": {
          "mode": "Source",
          "schema": {
            "type": "object",
            "properties": {
              "usage_analysis": {
                "type": "object"
              },
              "billing_analysis": {
                "type": "object"
              },
              "support_analysis": {
                "type": "object"
              },
              "contact_analysis": {
                "type": "object"
              }
            }
          }
        }
      },
      {
        "id": "churn_agent",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    return {'risk_score': 94, 'risk_level': 'CRITICAL', 'confidence': 0.95}"
        },
        "input": [
          {
            "lane": "text",
            "from": "churn_input"
          }
        ]
      },
      {
        "id": "churn_output",
        "provider": "response_text",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "churn_agent"
          }
        ]
      }
    ],
    "project_id": "c9445382-65f8-4560-9661-9f73850e2d90"
  }
}