{
  "pipeline": {
    "name": "SaveFlow Contact & Champion Specialist",
    "source": "contact_input",
    "version": "1.0.0",
    "description": "Detects key contact changes, internal champion departure events, and stakeholder role shifts.",
    "components": [
      {
        "id": "contact_input",
        "provider": "webhook",
        "config": {
          "mode": "Source"
        }
      },
      {
        "id": "contact_agent",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    dep = data.get('key_contact_status', 'stable') == 'departed'\n    health = 20 if dep else 100\n    return {'contact_health': health}"
        },
        "input": [
          {
            "lane": "text",
            "from": "contact_input"
          }
        ]
      },
      {
        "id": "contact_output",
        "provider": "response_text",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "contact_agent"
          }
        ]
      }
    ],
    "project_id": "95fc7500-4594-43a4-a25d-fcdfb670f5d7"
  }
}