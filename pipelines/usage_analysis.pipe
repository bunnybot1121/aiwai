{
  "pipeline": {
    "name": "SaveFlow Usage Analysis Specialist",
    "source": "usage_input",
    "version": "1.0.0",
    "description": "Analyzes NovaCloud product activity, active user decay, feature adoption, and login velocity.",
    "components": [
      {
        "id": "usage_input",
        "provider": "webhook",
        "config": {
          "mode": "Source"
        }
      },
      {
        "id": "usage_agent",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    pct = float(data.get('usage_change_pct', 0))\n    health = max(0, min(100, int(100 + (pct * 2.2))))\n    return {'usage_health': health, 'trend': 'declining' if pct < -10 else 'stable'}"
        },
        "input": [
          {
            "lane": "text",
            "from": "usage_input"
          }
        ]
      },
      {
        "id": "usage_output",
        "provider": "response_text",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "usage_agent"
          }
        ]
      }
    ],
    "project_id": "695016d9-c5c2-4ebf-a761-5678a4b645df"
  }
}