{
  "name": "SaveFlow Usage Analysis Specialist",
  "version": "1.0.0",
  "description": "Analyzes NovaCloud product activity, active user decay, feature adoption, and login velocity.",
  "components": [
    {
      "id": "usage_input",
      "provider": "webhook",
      "config": {
        "schema": {
          "type": "object",
          "properties": {
            "active_users": { "type": "integer" },
            "usage_change_pct": { "type": "number" },
            "feature_adoption_rate": { "type": "number" },
            "login_frequency_per_week": { "type": "number" }
          },
          "required": ["active_users", "usage_change_pct"]
        }
      }
    },
    {
      "id": "usage_agent",
      "provider": "agent_llm",
      "config": {
        "system_prompt": "You are the Usage Analysis Specialist for NovaCloud SaaS Churn Rescue Desk. Evaluate product usage drop, session decay, and feature adoption. Output JSON with usage_health (0-100), usage_trend (declining/stable/growing), and risk_factors array.",
        "temperature": 0.2
      },
      "input": [
        { "lane": "data", "from": "usage_input" }
      ]
    },
    {
      "id": "usage_output",
      "provider": "response",
      "config": {
        "laneName": "usage_analysis"
      },
      "input": [
        { "lane": "text", "from": "usage_agent" }
      ]
    }
  ]
}
