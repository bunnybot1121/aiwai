{
  "pipeline": {
    "name": "SaveFlow Billing Analysis Specialist",
    "source": "billing_input",
    "version": "1.0.0",
    "description": "Analyzes billing health, invoice overdue status, contract renewal timeline, and payment anomalies.",
    "components": [
      {
        "id": "billing_input",
        "provider": "webhook",
        "config": {
          "mode": "Source"
        }
      },
      {
        "id": "billing_agent",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    inv = str(data.get('invoice_status', 'paid')).lower()\n    health = 35 if inv == 'overdue' else 100\n    return {'billing_health': health}"
        },
        "input": [
          {
            "lane": "text",
            "from": "billing_input"
          }
        ]
      },
      {
        "id": "billing_output",
        "provider": "response_text",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "billing_agent"
          }
        ]
      }
    ],
    "project_id": "7746b636-49c3-4dd6-a91d-0993ffd288b0"
  }
}