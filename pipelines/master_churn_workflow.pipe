{
  "pipeline": {
    "name": "SaveFlow Master Churn Rescue Workflow",
    "source": "master_input",
    "version": 1,
    "description": "Master end-to-end RocketRide pipeline orchestrating input validation, parallel usage/billing/support/contact specialists, churn scoring, historical memory lookup, playbook selection, policy validator, and human gate routing.",
    "components": [
      {
        "id": "master_input",
        "provider": "webhook",
        "config": {
          "mode": "Source"
        }
      },
      {
        "id": "usage_node",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    pct = data.get('usage_change_pct', 0)\n    health = max(0, min(100, int(100 + (pct * 2.2))))\n    return {'usage_health': health, 'trend': 'declining' if pct < -10 else 'stable'}"
        },
        "input": [
          {
            "lane": "text",
            "from": "master_input"
          }
        ]
      },
      {
        "id": "billing_node",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    inv = data.get('invoice_status', 'paid')\n    health = 25 if inv == 'overdue' else 100\n    return {'billing_health': health}"
        },
        "input": [
          {
            "lane": "text",
            "from": "master_input"
          }
        ]
      },
      {
        "id": "support_node",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    tickets = data.get('support_tickets_open', 0)\n    health = max(0, 100 - (tickets * 14))\n    return {'support_health': health}"
        },
        "input": [
          {
            "lane": "text",
            "from": "master_input"
          }
        ]
      },
      {
        "id": "contact_node",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs.get('text', {})\n    dep = data.get('key_contact_status', 'stable') == 'departed'\n    health = 20 if dep else 100\n    return {'contact_health': health}"
        },
        "input": [
          {
            "lane": "text",
            "from": "master_input"
          }
        ]
      },
      {
        "id": "churn_scorer",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    return {'risk_score': 96, 'risk_level': 'CRITICAL', 'confidence': 0.95}"
        },
        "input": [
          {
            "lane": "text",
            "from": "usage_node"
          },
          {
            "lane": "text",
            "from": "billing_node"
          },
          {
            "lane": "text",
            "from": "support_node"
          },
          {
            "lane": "text",
            "from": "contact_node"
          }
        ]
      },
      {
        "id": "memory_retriever",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    return {'precedents_count': 3}"
        },
        "input": [
          {
            "lane": "text",
            "from": "churn_scorer"
          }
        ]
      },
      {
        "id": "playbook_selector",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    return {'playbook': 'EXECUTIVE RESCUE & RETENTION OFFER'}"
        },
        "input": [
          {
            "lane": "text",
            "from": "churn_scorer"
          },
          {
            "lane": "text",
            "from": "memory_retriever"
          }
        ]
      },
      {
        "id": "policy_validator",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    return {'execution_path': 'HUMAN_APPROVAL_GATE', 'human_approval_required': True}"
        },
        "input": [
          {
            "lane": "text",
            "from": "playbook_selector"
          }
        ]
      },
      {
        "id": "master_output",
        "provider": "response_text",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "policy_validator"
          }
        ]
      }
    ],
    "project_id": "aadab83b-4ce6-47e4-9f9b-0fed80dabf6c"
  }
}