{
  "pipeline": {
    "name": "SaveFlow Master Churn Rescue Workflow",
    "source": "master_input",
    "version": 1,
    "description": "Master end-to-end RocketRide pipeline orchestrating risk_intelligence.pipe, playbook selection, and human approval policy validation.",
    "components": [
      {
        "id": "master_input",
        "provider": "webhook",
        "config": {
          "mode": "Source"
        }
      },
      {
        "id": "ai_risk_analyst",
        "provider": "llm_openai",
        "config": {
          "profile": "gpt-oss-120b",
          "gpt-oss-120b": {
            "apikey": "rr_groq_api_key_buildathon"
          }
        },
        "input": [
          {
            "lane": "questions",
            "from": "master_input"
          }
        ]
      },
      {
        "id": "playbook_selector",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    risk_data = inputs if isinstance(inputs, dict) else {}\n    level = risk_data.get('risk_level', 'LOW')\n    score = risk_data.get('risk_score', 15)\n    drivers = risk_data.get('risk_drivers', [])\n    \n    if level == 'CRITICAL':\n        playbook = 'EXECUTIVE RESCUE & RETENTION OFFER'\n        actions = [\n            'Schedule Executive-to-Executive Rescue Call with VP of CS',\n            'Create Urgent Priority CSM Remediation Task',\n            'Draft Personalized Technical & Support Resolution Brief',\n            'Offer Pre-approved 15% Annual Contract Retention Discount'\n        ]\n        impact = 'high'\n    elif level == 'HIGH':\n        playbook = 'CSM OUTREACH & RETENTION OFFER'\n        actions = [\n            'Assign Senior CSM Intervention Task',\n            'Generate Personalized Executive Outreach Email',\n            'Schedule Account Alignment & Feature Adoption Meeting'\n        ]\n        impact = 'medium'\n    elif level == 'MEDIUM':\n        playbook = 'PERSONALIZED CSM CHECK-IN'\n        actions = [\n            'Send Automated CSM Check-in Email',\n            'Log Quarterly Usage Review Task'\n        ]\n        impact = 'low'\n    else:\n        playbook = 'STANDARD MONITORING'\n        actions = ['Maintain standard automated telemetry monitoring']\n        impact = 'none'\n        \n    risk_data['recommended_playbook'] = playbook\n    risk_data['proposed_actions'] = actions\n    risk_data['financial_impact'] = impact\n    return risk_data"
        },
        "input": [
          {
            "lane": "text",
            "from": "ai_risk_analyst"
          }
        ]
      },
      {
        "id": "policy_validator",
        "provider": "preprocessor_code",
        "config": {
          "code": "def process(inputs):\n    data = inputs if isinstance(inputs, dict) else {}\n    score = data.get('risk_score', 15)\n    level = data.get('risk_level', 'LOW')\n    conf = data.get('evidence_confidence', 0.95)\n    impact = data.get('financial_impact', 'none')\n    playbook = data.get('recommended_playbook', 'STANDARD MONITORING')\n    actions = data.get('proposed_actions', [])\n    disagreement = data.get('risk_disagreement', False)\n    \n    human_req = False\n    approval_reasons = []\n    if impact in ['high', 'medium'] or 'Discount' in playbook or '15%' in str(actions):\n        human_req = True\n        approval_reasons.append('Action involves financial retention discount / contractual changes')\n    if level == 'CRITICAL':\n        human_req = True\n        approval_reasons.append('Account is in CRITICAL risk tier (risk score >= 75)')\n    if conf < 0.75:\n        human_req = True\n        approval_reasons.append('Evidence completeness confidence score below 0.75 threshold')\n    if disagreement:\n        human_req = True\n        approval_reasons.append('AI Risk Score and Baseline Score exhibit significant disagreement (>= 25 pts)')\n        \n    exec_path = 'HUMAN_APPROVAL_GATE' if human_req else 'SAFE_AUTO_ACTION'\n    data['human_approval_required'] = human_req\n    data['approval_reasons'] = approval_reasons\n    data['execution_path'] = exec_path\n    data['rocketride_pipeline'] = 'master_churn_workflow.pipe'\n    data['risk_pipeline'] = 'risk_intelligence.pipe'\n    return data"
        },
        "input": [
          {
            "lane": "text",
            "from": "playbook_selector"
          }
        ]
      },
      {
        "id": "master_output",
        "provider": "response_json",
        "config": {},
        "input": [
          {
            "lane": "text",
            "from": "policy_validator"
          }
        ]
      }
    ],
    "project_id": "aadab83b-4ce6-47e4-9f9b-0fed80dabf6c"
  }
}